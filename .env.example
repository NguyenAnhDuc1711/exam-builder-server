# Copy this file to .env and fill in real values. Never commit .env.

# app/core/config.py
DATABASE_URL=postgresql+asyncpg://exam_builder:exam_builder@postgres:5432/exam_builder
JWT_SECRET_KEY=change-me
JWT_ACCESS_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_DAYS=7
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Comma-separated allowed origins for CORS (default: localhost dev ports)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis (forgot-password-otp feature)
REDIS_URL=redis://localhost:6379/0

# SMTP (forgot-password-otp feature)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@example.com

# Rate limiting (api-rate-limiting epic)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_WRITE_WINDOW_SECONDS=60
RATE_LIMIT_SUBMIT_MAX=10
RATE_LIMIT_SUBMIT_WINDOW_SECONDS=60
RATE_LIMIT_READ_MAX=100
RATE_LIMIT_READ_WINDOW_SECONDS=60
RATE_LIMIT_REDIS_TIMEOUT_MS=50
RATE_LIMIT_BREAKER_COOLDOWN_SECONDS=5


# docker-compose.yml (postgres + pgadmin services)
POSTGRES_USER=exam_builder
POSTGRES_PASSWORD=exam_builder
POSTGRES_DB=exam_builder
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# scripts/seed_admin.py — run once per environment to bootstrap the first
# admin account (no public sign-up exists by design): SEED_ADMIN_EMAIL=... \
# SEED_ADMIN_PASSWORD=... python -m scripts.seed_admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
